{
  "name": "unity-scene-refs",
  "displayName": "Unity Scene References",
  "description": "Shows Unity scene/prefab/animation references for C# methods and component usages as CodeLens (like Rider) in VS Code & Cursor",
  "version": "1.1.0",
  "publisher": "local",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoangledev/unity-scene-refs"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "unity",
    "codelens",
    "references",
    "csharp",
    "rider"
  ],
  "activationEvents": [
    "onLanguage:csharp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "unity-logo": {
        "description": "Unity Logo Icon",
        "default": {
          "fontPath": "./icons/unity-logo-v2.ttf",
          "fontCharacter": "\\E001"
        }
      }
    },
    "commands": [
      {
        "command": "unitySceneRefs.refresh",
        "title": "Unity Scene Refs: Refresh Index"
      },
      {
        "command": "unitySceneRefs.clearCache",
        "title": "Unity Scene Refs: Clear Cache & Re-index"
      },
      {
        "command": "unitySceneRefs.showReferences",
        "title": "Unity Scene Refs: Show References"
      },
      {
        "command": "unitySceneRefs.showComponentReferences",
        "title": "Unity Scene Refs: Show Component Usages"
      },
      {
        "command": "unitySceneRefs.showLog",
        "title": "Unity Scene Refs: Show Output Log"
      }
    ],
    "configuration": {
      "title": "Unity Scene References",
      "properties": {
        "unitySceneRefs.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Unity Scene References CodeLens"
        },
        "unitySceneRefs.scanPath": {
          "type": "string",
          "default": "Assets",
          "description": "Relative directory in workspace to scan (e.g. 'Assets' or 'Assets/_Project')"
        },
        "unitySceneRefs.includeAssets": {
          "type": "boolean",
          "default": false,
          "description": "Also scan ScriptableObject .asset files (may increase scan time)"
        },
        "unitySceneRefs.includeAnimations": {
          "type": "boolean",
          "default": true,
          "description": "Scan .anim files for Animation Events calling C# methods"
        },
        "unitySceneRefs.showComponentUsages": {
          "type": "boolean",
          "default": true,
          "description": "Show CodeLens for MonoBehaviour component usages on class declarations"
        },
        "unitySceneRefs.bridgePort": {
          "type": "number",
          "default": 7892,
          "description": "HTTP port for Unity Editor Bridge"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "IMAGE_BASE_URL=${IMAGE_BASE_URL-https://raw.githubusercontent.com/hoangledev/unity-scene-refs/main} node scripts/embed-readme-images.js && npx @vscode/vsce package --no-dependencies --allow-missing-repository --no-rewrite-relative-links --readme-path build/README.md"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^3.0.0"
  }
}
